# Query 1: Simple fact lookup - Volvo Q1 net sales
# Highlights: precise data retrieval from a single document

Output recordings/01_volvo_net_sales.mp4

Set Shell bash
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Dracula"
Set TypingSpeed 40ms
Set PlaybackSpeed 1.0

Hide
Type "cd /home/axel-oeberg/pvk/quantera && source venv/bin/activate && clear"
Enter
Sleep 500ms
Show

Sleep 800ms
Type `make query Q="What is the Q1 2025 net sales of Volvo Group?"`
Sleep 500ms
Enter
Sleep 12s

# Query 8: Specific metric - Ericsson FCF (negative number)
# Highlights: surfaces important detail (negative FCF) that's easy to miss manually

Output recordings/08_free_cash_flow.mp4

Set Shell bash
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Dracula"
Set TypingSpeed 40ms
Set PlaybackSpeed 1.0

Hide
Type "cd /home/axel-oeberg/pvk/quantera && source venv/bin/activate && clear"
Enter
Sleep 500ms
Show

Sleep 800ms
Type `make query Q="What is the Q1 2025 free cash flow of Ericsson?"`
Sleep 500ms
Enter
Sleep 12s

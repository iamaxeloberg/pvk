# Low-cost LLM for categorisation & retrieval filtering
LOW_COST_LLM_MODEL=deepseek/deepseek-chat
LOW_COST_LLM_API_KEY=
LOW_COST_LLM_API_BASE=

# High-capacity LLM for final response generation
HIGH_CAPACITY_LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
HIGH_CAPACITY_LLM_API_KEY=

# Database
DB_PATH=data/quantera.db

# Directories
INPUT_DIR=data/input
MARKDOWN_DIR=data/markdown

# LLM Settings
TEMPERATURE=0.0
MAX_TOKENS=4096

# Chunking
CHUNK_SIZE=4000
CHUNK_OVERLAP=200

# Document size limit (chars)
MAX_DOC_SIZE_CHARS=100000

# Low-cost LLM for categorisation & retrieval filtering
# When using FreeLLMAPI (http://localhost:3001/v1):
#   - Use model="openai/<model-name>" format required by litellm
#   - Set API key to any non-empty string (FreeLLMAPI skips auth for localhost)
#   - The model name is just for litellm routing; FreeLLMAPI auto-routes regardless
LOW_COST_LLM_MODEL=openai/gemini-2.5-flash
LOW_COST_LLM_API_KEY=dummy
LOW_COST_LLM_API_BASE=http://localhost:3001/v1

# High-capacity LLM for final response generation
HIGH_CAPACITY_LLM_MODEL=openai/gemini-2.5-flash
HIGH_CAPACITY_LLM_API_KEY=dummy
HIGH_CAPACITY_LLM_API_BASE=http://localhost:3001/v1

# Database
DB_PATH=data/quantera.db

# Directories
INPUT_DIR=data/input
MARKDOWN_DIR=data/markdown

# LLM Settings
TEMPERATURE=0.0
MAX_TOKENS=4096

# Chunking
CHUNK_SIZE=4000
CHUNK_OVERLAP=200

# Document size limit (chars)
MAX_DOC_SIZE_CHARS=100000

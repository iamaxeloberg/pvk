# LLM Configuration
# Use LiteLLM model identifiers: provider/model-name
# Examples: openai/gpt-4o, anthropic/claude-3-5-sonnet, deepseek/deepseek-chat
#
# API key and base URL are optional — if unset, LiteLLM uses its defaults
# (environment variables like OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.)

LOW_COST_LLM_MODEL=deepseek/deepseek-chat
LOW_COST_LLM_API_KEY=
LOW_COST_LLM_API_BASE=

HIGH_CAPACITY_LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
HIGH_CAPACITY_LLM_API_KEY=
HIGH_CAPACITY_LLM_API_BASE=

# Database
DB_PATH=data/quantera.db

# Directories
INPUT_DIR=data/input
MARKDOWN_DIR=data/markdown

# LLM Settings
TEMPERATURE=0.0
MAX_TOKENS=4096

# Chunking
CHUNK_SIZE=4000
CHUNK_OVERLAP=200

# Document size limit (chars)
MAX_DOC_SIZE_CHARS=100000
